{
    "name": "mhrshuvo/journey-log",
    "description": "JSON based folder-wise user journey logger for Laravel applications. Track user behavior with organized JSON logs and built-in analytics dashboard.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": [
        "laravel", 
        "logging", 
        "journey", 
        "analytics", 
        "tracking", 
        "user-behavior", 
        "json-logs", 
        "middleware"
    ],
    "homepage": "https://github.com/mhrshuvo/journey-log",
    "support": {
        "issues": "https://github.com/mhrshuvo/journey-log/issues",
        "source": "https://github.com/mhrshuvo/journey-log"
    },
    "autoload": {
        "psr-4": {
            "mhrshuvo\\JourneyLog\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "mhrshuvo\\JourneyLog\\JourneyLogServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "mhrshuvo",
            "email": "18103361@iubat.edu"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "mhrshuvo\\JourneyLog\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "orchestra/testbench": "^9.16",
        "laravel/pint": "*"
    }
}
